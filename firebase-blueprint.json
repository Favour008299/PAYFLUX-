{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized PayFlux administrator user record for RBAC",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier of the admin user or document key"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin email address"
        },
        "role": {
          "type": "string",
          "enum": ["superadmin", "admin"],
          "description": "Permission role of the administrator"
        },
        "name": {
          "type": "string",
          "description": "Display name of the admin"
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL"
        },
        "addedBy": {
          "type": "string",
          "description": "Identity of the superadmin who authorized this account"
        },
        "addedAt": {
          "type": "number",
          "description": "Epoch timestamp when admin was authorized"
        },
        "status": {
          "type": "string",
          "enum": ["active", "revoked"],
          "description": "Current authorization status"
        }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "SwapRecord": {
      "title": "SwapRecord",
      "description": "On-chain swap transaction audit record including attempts, confirmations, and failures",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userAddress": { "type": "string" },
        "fromTokenSymbol": { "type": "string" },
        "toTokenSymbol": { "type": "string" },
        "fromAmount": { "type": "string" },
        "toAmount": { "type": "string" },
        "fromAmountUsd": { "type": "number" },
        "toAmountUsd": { "type": "number" },
        "pair": { "type": "string" },
        "network": { "type": "string" },
        "chainId": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "success", "failed", "rejected", "cancelled"] },
        "failureReason": { "type": "string" },
        "txHash": { "type": "string" },
        "blockNumber": { "type": "number" },
        "timestamp": { "type": "number" },
        "explorerUrl": { "type": "string" },
        "isCrossChain": { "type": "boolean" },
        "routingProtocol": { "type": "string" }
      },
      "required": ["id", "userAddress", "fromTokenSymbol", "toTokenSymbol", "fromAmount", "toAmount", "status", "timestamp"]
    },
    "MerchantProfile": {
      "title": "MerchantProfile",
      "description": "Public merchant profile containing latest status, product, price and receiving preferences",
      "type": "object",
      "properties": {
        "merchantName": { "type": "string" },
        "productName": { "type": "string" },
        "priceAmount": { "type": "number" },
        "currency": { "type": "string" },
        "receivingAsset": { "type": "string" },
        "receivingNetwork": { "type": "string", "enum": ["polygon", "ethereum"] },
        "walletAddress": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["merchantName", "productName", "priceAmount", "currency", "receivingAsset", "receivingNetwork", "walletAddress", "updatedAt"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Persistent payment transaction record for customer checkout and merchant audit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceId": { "type": "string" },
        "merchantName": { "type": "string" },
        "merchantAddress": { "type": "string" },
        "productName": { "type": "string" },
        "payerAddress": { "type": "string" },
        "amountPaid": { "type": "string" },
        "tokenSymbol": { "type": "string" },
        "fiatValueUsd": { "type": "number" },
        "fiatAmount": { "type": "number" },
        "fiatCurrency": { "type": "string" },
        "payfluxFeeUsd": { "type": "number" },
        "txHash": { "type": "string" },
        "network": { "type": "string" },
        "chainId": { "type": "number" },
        "timestamp": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "failed", "pending"] },
        "failureReason": { "type": "string" },
        "networkFeeUsd": { "type": "number" },
        "explorerUrl": { "type": "string" }
      },
      "required": ["id", "merchantAddress", "amountPaid", "tokenSymbol", "status", "timestamp"]
    },
    "HistoryRecord": {
      "title": "HistoryRecord",
      "description": "Persistent transaction history item for wallet actions (swaps, payments, transfers)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hash": { "type": "string" },
        "type": { "type": "string", "enum": ["swap", "send", "receive", "payment"] },
        "fromTokenSymbol": { "type": "string" },
        "toTokenSymbol": { "type": "string" },
        "fromAmount": { "type": "string" },
        "toAmount": { "type": "string" },
        "tokenSymbol": { "type": "string" },
        "amount": { "type": "string" },
        "recipientAddress": { "type": "string" },
        "senderAddress": { "type": "string" },
        "timestamp": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "pending", "failed"] },
        "networkFeeUsd": { "type": "number" },
        "blockNumber": { "type": "number" },
        "explorerUrl": { "type": "string" },
        "network": { "type": "string" },
        "orderId": { "type": "string" }
      },
      "required": ["id", "hash", "type", "timestamp", "status"]
    }
  },
  "firestore": {
    "/payflux_admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Collection storing authorized administrator records and access privileges"
    },
    "/payflux_swaps/{swapId}": {
      "schema": "SwapRecord",
      "description": "Collection storing swap analytics records"
    },
    "/payflux_merchants/{merchantAddress}": {
      "schema": "MerchantProfile",
      "description": "Directory storing public merchant profile configurations and live prices"
    },
    "/payflux_payments/{paymentId}": {
      "schema": "PaymentRecord",
      "description": "Persistent payment and checkout transaction logs"
    },
    "/payflux_history/{historyId}": {
      "schema": "HistoryRecord",
      "description": "Persistent transaction history records"
    }
  }
}
